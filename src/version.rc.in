#include <winver.h>
1 VERSIONINFO
FILEVERSION @MOD_FIXED_VERSION@
PRODUCTVERSION @MOD_FIXED_VERSION@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Sonic853\0"
      VALUE "FileDescription", "TTPlayer Tracker modules audio add-in\0"
      VALUE "FileVersion", "@MOD_BUILD_VERSION@\0"
      VALUE "InternalName", "ttp_mod\0"
      VALUE "OriginalFilename", "ttp_mod.dll\0"
      VALUE "ProductName", "TTPlayer Rebuild MOD\0"
      VALUE "ProductVersion", "@MOD_BUILD_VERSION@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
